RewriteRule ^womens-golf-shirts/page-11(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-2(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-3(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-4(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-5(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-6(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-8(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/page-9(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/price_min-0-price_max-48-sort-newest(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/price_min-123-price_max-161-sort-newest(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/price_min-161-price_max-199-sort-newest(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/price_min-48-price_max-86-sort-newest(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shirts/price_min-86-price_max-123-sort-newest(\.html)?/?$ https://fore-ladies.com/womens-golf-shirts? [R=301,L]
RewriteRule ^womens-golf-shoes/page-2(\.html)?/?$ https://fore-ladies.com/womens-golf-shoes? [R=301,L]

# Sort / filter / pagination variants -> the category itself (only if it exists)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/(sort-[a-z]+(-page-[0-9]+)?|page-[0-9]+|price_min[^/]*|filter[^/]*)(\.html)?/?$ https://fore-ladies.com/$1? [R=301,L]


# index.html -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?]
RewriteRule ^index(\.html)?$ https://fore-ladies.com/ [R=301,L]
# .html in the address bar -> clean URL
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?]
RewriteRule ^ https://fore-ladies.com/%1 [R=301,L,NE]
# trailing slash -> clean URL (old BigCommerce links used it)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ https://fore-ladies.com/%1 [R=301,L,NE]
# ?m=1 and other old query junk on pages
RewriteCond %{QUERY_STRING} (^|&)(m=1|sort=|page=|setCurrencyId=|action=)
RewriteRule ^(.*)$ https://fore-ladies.com/$1? [R=301,L,NE]
# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://fore-ladies.com/$1 [R=301,L,NE]

# Serve clean URLs from .html files
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/xml image/svg+xml application/rss+xml
</IfModule>
