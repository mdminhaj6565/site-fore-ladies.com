# Generated by _build/build.py — edit _build/content/redirects.json instead.
Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Private folders
RewriteRule ^(_build|\.git|data|README\.md)(/|$) - [F,L]

# Old platform URLs
RewriteRule ^(rss\.php|blog/rss|blog/feed|feed)(\.html)?/?$ https://fore-ladies.com/feed.xml? [R=301,L]
RewriteRule ^xmlsitemap\.php$ https://fore-ladies.com/sitemap.xml? [R=301,L]
RewriteRule ^(cart|checkout|login|wishlist|compare|account|giftcertificates)(\.php|\.html)?/?$ https://fore-ladies.com/? [R=301,L]
RewriteRule ^(login_|wishlist_|giftcertificates_|account_)[^/]*$ https://fore-ladies.com/? [R=301,L]
RewriteRule ^products_productId[^/]*$ https://fore-ladies.com/? [R=301,L]

# Old store search pages -> closest category
RewriteRule ^search[^/]*golf\-dress[^/]*$ https://fore-ladies.com/golf-dresses? [R=301,L,NC]
RewriteRule ^search[^/]*good\-dress[^/]*$ https://fore-ladies.com/golf-dresses? [R=301,L,NC]
RewriteRule ^search[^/]*golddress[^/]*$ https://fore-ladies.com/golf-dresses? [R=301,L,NC]
RewriteRule ^search[^/]*gooddress[^/]*$ https://fore-ladies.com/golf-dresses? [R=301,L,NC]
RewriteRule ^search[^/]*golf\-pants[^/]*$ https://fore-ladies.com/bottoms/pants? [R=301,L,NC]
RewriteRule ^search[^/]*golf\-skort[^/]*$ https://fore-ladies.com/bottoms/skorts? [R=301,L,NC]
RewriteRule ^search[^/]*golf\-skirt[^/]*$ https://fore-ladies.com/bottoms/skorts? [R=301,L,NC]
RewriteRule ^search[^/]*jacket[^/]*$ https://fore-ladies.com/outerwear/jackets? [R=301,L,NC]
RewriteRule ^search[^/]*pullover[^/]*$ https://fore-ladies.com/outerwear/pullovers? [R=301,L,NC]
RewriteRule ^search[^/]*kinona[^/]*$ https://fore-ladies.com/kinona-womens-golf-clothes? [R=301,L,NC]
RewriteRule ^search[^/]*sleeveless[^/]*$ https://fore-ladies.com/tops/sleeveless? [R=301,L,NC]
RewriteRule ^search[^/]*short\-sleeve[^/]*$ https://fore-ladies.com/tops/short-sleeves? [R=301,L,NC]
RewriteRule ^search[^/]*golfshirt[^/]*$ https://fore-ladies.com/womens-golf-shirts? [R=301,L,NC]
RewriteCond %{QUERY_STRING} search_query=[^&]*dress [NC]
RewriteRule ^search\.php$ https://fore-ladies.com/golf-dresses? [R=301,L]
RewriteCond %{QUERY_STRING} search_query=[^&]*sk(o|i)rt [NC]
RewriteRule ^search\.php$ https://fore-ladies.com/bottoms/skorts? [R=301,L]
RewriteCond %{QUERY_STRING} search_query=[^&]*pant [NC]
RewriteRule ^search\.php$ https://fore-ladies.com/bottoms/pants? [R=301,L]
RewriteCond %{QUERY_STRING} search_query=[^&]*jacket [NC]
RewriteRule ^search\.php$ https://fore-ladies.com/outerwear/jackets? [R=301,L]
RewriteCond %{QUERY_STRING} search_query=[^&]*tennis [NC]
RewriteRule ^search\.php$ https://fore-ladies.com/tennis-clothes-women? [R=301,L]
RewriteRule ^search(\.php)?[^/]*$ https://fore-ladies.com/womens-golf-clothes? [R=301,L]

